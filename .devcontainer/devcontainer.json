// GitHub Codespaces / VS Code Dev Containers: hiçbir şey kurmadan tarayıcıda çalıştırmak için.
// Tek konteyner: Node 22 + aynı konteynerde PostgreSQL. İlk açılışta bağımlılıklar kurulur,
// veritabanı demo veriyle doldurulur ve uygulama derlenir (3-5 dk). Sonra uygulama bir
// terminalde 3000 portunda başlar.
{
  "name": "Paventech ERP",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22-bookworm",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Paventech ERP", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "sudo service postgresql start",
  "postAttachCommand": "bash .devcontainer/start.sh",
  "hostRequirements": { "cpus": 2, "memory": "4gb" },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": { "extensions": ["dbaeumer.vscode-eslint", "bradlc.vscode-tailwindcss"] }
  }
}
