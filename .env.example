# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
# Yerel PostgreSQL (docker compose up -d ile ayağa kalkan) için varsayılanlar:
DATABASE_URL=postgres://paventech:paventech@localhost:5432/paventech_dev
TEST_DATABASE_URL=postgres://paventech:paventech@localhost:5432/paventech_test

# En az 32 karakterlik rastgele bir değer. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Giriş ekranında demo hesaplarını göster (canlı ortamda 0 yapın)
NEXT_PUBLIC_DEMO=1
